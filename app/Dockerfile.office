# Бэк-офис: собирается в статику и копируется на том, который раздаёт Caddy.
FROM node:20-alpine AS build
WORKDIR /build
RUN npm i -g pnpm@9
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/backoffice ./apps/backoffice
RUN pnpm install --no-frozen-lockfile
RUN cd apps/backoffice && pnpm exec vite build --base=/office/

FROM alpine
RUN apk add --no-cache rsync
COPY --from=build /build/apps/backoffice/dist /dist
# Копируем в примонтированную папку сайта и завершаемся
CMD ["sh", "-c", "rsync -a --delete /dist/ /out/ && echo 'Бэк-офис собран в /out'"]
