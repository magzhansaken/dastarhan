// Dastarhan POS — Этап 3: Оплаты и фискализация КЗ
// Глубина по лучшему из 5:
//  - смешанная оплата несколькими типами + отмена частичной — QuickResto oplata
//  - выбор фискального провайдера (не один!) — Paloma (5 провайдеров)
//  - «какие операции фискализировать — выбирает владелец» — Poster fiscalization
//  - интерфейс драйвера sell/refund с errorCode — Poster dev device/fiscal
//  - Kaspi: сумма летит на терминал автоматически; конфликт с Kaspi Kassa
//    задокументирован — Paloma kaspi-terminal
//  - ОФЛАЙН-фискализация: чек уходит в очередь и пробивается при сети
//    (Poster: печать чеков офлайн; Webkassa API это позволяет)

// ═══════════════ СПОСОБЫ ОПЛАТЫ ═══════════════

enum PayKind {
  CASH        // наличные (сдача!)
  CARD        // банковский терминал (Kaspi/Halyk/Forte — интеграция суммы)
  KASPI_QR    // Kaspi QR на экране кассы
  BONUS       // бонусами (Этап 6 — каркас сейчас)
  TRANSFER    // перевод/прочее (настраиваемые типы — у всех 5 есть «свои типы»)
}

// Настраиваемый способ оплаты точки (владелец создаёт свои — Poster
// how-to-create-a-new-order-payment-method)
model PaymentMethod {
  id         String  @id @default(cuid())
  accountId  String
  name       String            // «Наличные», «Kaspi терминал», «Halyk»
  kind       PayKind
  // Привязка к железу/интеграции (терминал Kaspi этой кассы и т.п.)
  driver     String?           // 'kaspi_terminal' | 'halyk_terminal' | 'kaspi_qr' | null
  // Фискализировать ли операции этим способом (Poster: владелец выбирает)
  fiscalize  Boolean @default(true)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)
}

// ═══════════════ ПЛАТЕЖИ ЗАКАЗА ═══════════════

enum PaymentStatus {
  PENDING    // создан (например, ждём ответ терминала)
  CAPTURED   // деньги получены
  FAILED
  VOIDED     // отменён при частичной оплате (QR: «отменить транзакцию»)
  REFUNDED   // возвращён (частично/полностью — через Refund)
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  methodId   String
  kind       PayKind
  amount     Int           // тиыны; для CASH — сумма К ЗАЧЁТУ (не полученная!)
  tendered   Int?          // CASH: сколько дал гость; сдача = tendered − amount
  status     PaymentStatus @default(PENDING)
  // Ссылка на транзакцию внешней системы (RRN терминала, id Kaspi QR)
  externalRef String?
  createdAt  DateTime      @default(now())
  capturedAt DateTime?

  refunds Refund[]
  @@index([orderId])
}

model Refund {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  amount     Int
  reason     String   // причина обязательна (правило этапа 2)
  byUserId   String
  createdAt  DateTime @default(now())
  fiscalId   String?  // ссылка на фискальный чек возврата
}

// ═══════════════ ФИСКАЛИЗАЦИЯ ═══════════════

// Провайдер аккаунта: выбор из нескольких (Paloma-модель). credentials — JSONB
// (токены/ключи Webkassa|reKassa). При росте добавляем провайдеров без миграций.
model FiscalProvider {
  id         String  @id @default(cuid())
  accountId  String
  locationId String?          // можно свой провайдер на точку
  type       String           // 'webkassa' | 'rekassa' | 'noop'
  credentials Json
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)
}

enum FiscalOp {
  SELL
  REFUND
}
enum FiscalStatus {
  QUEUED     // офлайн/ожидает
  SENT       // пробит успешно
  ERROR      // ошибка провайдера (ретраи)
  SKIPPED    // способ оплаты без фискализации
}

// Очередь фискализации — ключ офлайн-надёжности: продажа НЕ блокируется
// недоступностью Webkassa; чек догоняется с ретраями и backoff.
model FiscalReceipt {
  id          String       @id @default(cuid())
  accountId   String
  orderId     String
  op          FiscalOp
  providerId  String
  // Слепок данных чека (позиции, суммы, НДС) — неизменен после создания
  payload     Json
  status      FiscalStatus @default(QUEUED)
  attempts    Int          @default(0)
  nextTryAt   DateTime?
  // Ответ провайдера: номер фискального чека, ссылка ОФД, QR
  fiscalNumber String?
  ofdUrl       String?
  error        String?
  createdAt   DateTime     @default(now())
  sentAt      DateTime?

  @@index([status, nextTryAt])
  @@index([orderId])
}
