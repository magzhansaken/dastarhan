// Dastarhan POS — Этап 8: ИИ-модуль («Данакер» — рабочее имя ассистента)
// Единственный образец на рынке — Postie AI (Poster), 4 функции:
//   1) фото накладной → поставка; 2) выписка CSV/XLS/PDF → транзакции
//   по категориям; 3) аналитика по текстовому вопросу; 4) фудкост-контроль.
// Наши углубления против Postie:
//   - ЧЕРНОВИК-ПРИНЦИП: ИИ никогда не проводит документы сам — только
//     готовит черновик с confidence; человек подтверждает (доверие = продажи)
//   - матчинг позиций к номенклатуре с прозрачным скорингом (у Postie
//     «магия», у нас — объяснимо: почему сматчилось)
//   - выписки Kaspi Pay/Halyk — казахстанские мерчанты в категоризации
//     (у Postie нет КЗ-специфики)
//   - фудкост-сигналы — не LLM, а детерминированные правила (дёшево, надёжно);
//     LLM подключается только там, где нужен интеллект (парсинг, язык)
// Движок: Claude API (vision для фото, structured output для парсинга).

enum AiJobType {
  INVOICE_PHOTO   // фото/скан накладной → черновик SUPPLY
  BANK_STATEMENT  // PDF/CSV выписка (Kaspi/Halyk/любой) → транзакции
  REPORT_QUERY    // текстовый вопрос → параметры отчёта + ответ
  MENU_IMPORT     // фото меню конкурента/своего → черновик номенклатуры
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  READY       // черновик готов, ждёт подтверждения человеком
  CONFIRMED   // человек принял (возможно, с правками) → документ создан
  REJECTED    // человек отклонил (фидбек для улучшения промптов)
  FAILED
}

model AiJob {
  id         String      @id @default(cuid())
  accountId  String
  locationId String?
  type       AiJobType
  status     AiJobStatus @default(QUEUED)
  // Вход: ссылка на файл (S3) или текст запроса
  inputFileUrl String?
  inputText    String?
  // Выход: структурированный черновик (формат зависит от type)
  draft      Json?
  // Уверенность 0..1 по строкам и в целом; низкая — подсветка в UI
  confidence Decimal?
  // Правки человека при подтверждении (обучающий сигнал)
  humanEdits Json?
  resultDocId String?   // созданный документ после CONFIRMED
  error      String?
  byUserId   String
  createdAt  DateTime @default(now())
  doneAt     DateTime?

  @@index([accountId, type, status])
}

// Память матчинга: «Молоко Отборное 3.2% 1л» у этого поставщика = наш продукт X.
// Один раз подтвердил — дальше матчится мгновенно и точно (у Postie нет).
model AiItemAlias {
  id         String @id @default(cuid())
  accountId  String
  supplierId String?
  rawName    String   // как в накладной
  productId  String   // наш продукт
  @@unique([accountId, supplierId, rawName])
}

// Правила категоризации выписок: мерчант → категория ДДС.
// Предзаполнены казахстанскими (Magnum, Small, КазТрансГаз, Алматы Су...),
// пополняются подтверждениями пользователя.
model AiMerchantRule {
  id         String @id @default(cuid())
  accountId  String? // null = глобальное правило платформы
  pattern    String  // подстрока/regex по назначению платежа
  categoryName String
  @@index([accountId])
}
