// Dastarhan POS — Этап 4: Склад
// Глубина по лучшему из 5:
//  - документная модель с проведением DRAFT→POSTED — Paloma («что такое
//    проведение документов») + QuickResto (все акты проводятся)
//  - типы документов — объединение всех: приход, списание, перемещение,
//    инвентаризация, производство, разделка/переработка, возврат поставщику,
//    оприходование излишков — QuickResto akty + Paloma документы
//  - себестоимость: скользящая средневзвешенная при приходе — Poster
//    how-the-cost-is-calculated
//  - ИНВЕНТАРИЗАЦИЯ БЕЗ ОСТАНОВКИ ПРОДАЖ: точка отсчёта + операции во время
//    пересчёта учитываются — Paloma (уникальная фича, берём как стандарт)
//  - отрицательные остатки РАЗРЕШЕНЫ (5−8=−3) — Paloma «актуализация»:
//    продажа никогда не блокируется складом (совпадает с офлайн-философией)
//  - ledger-архитектура: остаток = сумма движений; StockBalance — кэш

// ═══════════════ СКЛАДЫ ═══════════════

model Warehouse {
  id         String  @id @default(cuid())
  locationId String
  name       String  // «Кухня», «Бар», «Основной»
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)
}

// ═══════════════ ДОКУМЕНТЫ ═══════════════

enum StockDocType {
  SUPPLY        // приход от поставщика
  WRITEOFF      // списание с причиной (порча/бой/угощение)
  SALE          // авто-списание по продажам (агрегат за смену или по чеку)
  TRANSFER      // перемещение склад→склад
  INVENTORY     // инвентаризация (снимок + корректировка)
  PRODUCTION    // производство: списать ингредиенты ПФ → оприходовать ПФ
  BUTCHERING    // разделка/переработка: списать целое → оприходовать части
  SUPPLIER_RETURN // возврат поставщику
  SURPLUS       // оприходование излишков
}

enum StockDocStatus {
  DRAFT
  POSTED    // проведён — движения созданы
  VOIDED    // распроведён (движения сторнированы)
}

model StockDoc {
  id          String         @id @default(cuid())
  accountId   String
  locationId  String
  type        StockDocType
  status      StockDocStatus @default(DRAFT)
  number      Int
  warehouseId String         // основной склад документа
  // TRANSFER: склад-получатель
  toWarehouseId String?
  supplierId  String?        // SUPPLY/SUPPLIER_RETURN (контрагенты — Этап 5)
  // INVENTORY: точка отсчёта пересчёта (механизм Paloma «без остановки»)
  countStartedAt DateTime?
  reason      String?        // WRITEOFF: причина обязательна
  note        String?
  createdBy   String
  createdAt   DateTime       @default(now())
  postedAt    DateTime?

  lines StockDocLine[]
  @@index([accountId, locationId, type])
  @@unique([locationId, type, number])
}

model StockDocLine {
  id        String   @id @default(cuid())
  docId     String
  doc       StockDoc @relation(fields: [docId], references: [id])
  productId String
  qty       Decimal  // в базовых единицах; для INVENTORY = ФАКТ пересчёта
  // SUPPLY: цена закупки за единицу (тиыны) — источник себестоимости
  unitCost  Int?
  // BUTCHERING: роль строки: INPUT (туша) | OUTPUT (части)
  role      String?  // 'IN' | 'OUT' (для PRODUCTION/BUTCHERING)
  sortOrder Int      @default(0)

  @@index([docId])
}

// ═══════════════ ДВИЖЕНИЯ (LEDGER) ═══════════════

// Каждое проведение документа порождает движения ±. Остаток склада =
// Σ движений. Это даёт полный аудит «откуда взялась цифра» (боль всех
// конкурентов — «почему остаток такой?» — у нас разложимо по движениям).
model StockMovement {
  id          String   @id @default(cuid())
  accountId   String
  warehouseId String
  productId   String
  docId       String?  // источник (null для авто-продаж до агрегации)
  orderId     String?  // для SALE-списаний — связь с чеком
  qtyDelta    Decimal  // + приход, − расход
  // Себестоимость единицы на момент движения (для расходов — текущая средняя)
  unitCost    Int
  at          DateTime @default(now())

  @@index([warehouseId, productId, at])
  @@index([docId])
}

// Кэш остатков и средней себестоимости (пересчитывается при проведении)
model StockBalance {
  id          String  @id @default(cuid())
  warehouseId String
  productId   String
  qty         Decimal @default(0)  // МОЖЕТ БЫТЬ ОТРИЦАТЕЛЬНЫМ (Paloma 5−8=−3)
  avgCost     Int     @default(0)  // средневзвешенная, тиыны за единицу

  @@unique([warehouseId, productId])
}
