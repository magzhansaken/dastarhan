// Dastarhan POS — Этап 10 (финальный): Платформа продаж
// Глубина по лучшему из 5:
//  - подписочные лицензии (SAAS + с периодом) — r_keeper License («Генерация
//    лицензий по подписке», справочники Корпорации/Дилеры/Объекты)
//  - дилерская машина: демо-стенды, Service Desk, ЭСКАЛАЦИЯ заявок с
//    автодобавлением руководителей — r_keeper Fordealers (учебник модели)
//  - простая формула цены: «каждая точка = ещё один тариф, включает 1 кассу»
//    — Poster (против зоопарка лицензий r_keeper — мы за простоту Poster)
// Наши углубления:
//  - GRACE-ПЕРИОД с деградацией, а не рубильником: касса офлайн-первая и
//    ОБЯЗАНА продолжать пробивать чеки; при неоплате сначала read-only
//    бэк-офис, касса живёт grace-дней — доверие и закон (чек нельзя не дать!)
//  - дилерская комиссия = % ОТ ПОДПИСКИ ЕЖЕМЕСЯЧНО (recurring share) — у
//    r_keeper дилер зарабатывает на внедрении, у нас на LTV → дилер
//    заинтересован, чтобы клиент ЖИЛ долго
//  - PRORATION при смене тарифа посреди периода — честный перерасчёт

// ═══════════════ ТАРИФЫ ═══════════════

model Plan {
  id        String @id @default(cuid())
  code      String @unique // 'start' | 'standard' | 'pro'
  name      String
  pricePerLocationMonth Int  // тиыны; Poster-формула: цена × точки
  // Лимиты на ТОЧКУ
  terminalsPerLocation Int  @default(1)
  // Модули по тарифу (JSON-флаги: ai, delivery, loyalty, verticals...)
  modules   Json
  isActive  Boolean @default(true)
}

// ═══════════════ ПОДПИСКА ═══════════════

enum SubStatus {
  TRIAL      // 14 дней полного функционала
  ACTIVE
  PAST_DUE   // не оплачено: бэк-офис read-only, касса работает (grace)
  SUSPENDED  // grace истёк: касса read-only (открытые смены закрыть можно)
  CANCELLED
}

model Subscription {
  id         String    @id @default(cuid())
  accountId  String    @unique
  planId     String
  status     SubStatus @default(TRIAL)
  locationsCount Int   @default(1)   // оплаченное число точек
  periodStart DateTime
  periodEnd   DateTime
  trialEnd    DateTime?
  graceDays   Int      @default(7)
  dealerId    String?  // продавший/сопровождающий дилер
  createdAt  DateTime  @default(now())

  payments SubPayment[]
}

model SubPayment {
  id        String   @id @default(cuid())
  subId     String
  sub       Subscription @relation(fields: [subId], references: [id])
  amount    Int
  method    String   // 'kaspi' | 'invoice' | 'card'
  periodFrom DateTime
  periodTo   DateTime
  at        DateTime @default(now())
}

// ═══════════════ ДИЛЕРЫ (r_keeper Fordealers, углублено) ═══════════════

model Dealer {
  id         String @id @default(cuid())
  name       String
  binIin     String
  region     String   // города/области КЗ
  // Recurring-комиссия: % от подписок его клиентов КАЖДЫЙ месяц
  commissionPct Decimal @default(20)
  contactPhone String
  isActive   Boolean @default(true)

  demoAccounts DemoAccount[]
}

// Демо-стенды (r_keeper): дилер разворачивает демо клиенту в 1 клик, TTL
model DemoAccount {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id])
  accountId String   @unique // полноценный аккаунт с демо-данными вертикали
  vertical  String
  expiresAt DateTime // авто-очистка
  convertedAt DateTime? // стал платящим — засчитан дилеру
  createdAt DateTime @default(now())
}

// Начисления дилеру (по оплатам подписок его клиентов)
model DealerAccrual {
  id        String   @id @default(cuid())
  dealerId  String
  subPaymentId String @unique
  amount    Int      // тиыны = payment × commissionPct
  paidAt    DateTime?
  createdAt DateTime @default(now())
}

// ═══════════════ SERVICE DESK: ЭСКАЛАЦИЯ (r_keeper) ═══════════════

enum TicketLevel {
  DEALER
  VENDOR
}   // 1-я линия дилер → эскалация к нам
enum TicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

model Ticket {
  id         String       @id @default(cuid())
  accountId  String
  dealerId   String?
  level      TicketLevel  @default(DEALER)
  status     TicketStatus @default(OPEN)
  priority   String       @default("normal") // low|normal|high|critical
  subject    String
  body       String
  // SLA: срок реакции по приоритету; просрочка → авто-эскалация
  dueAt      DateTime
  escalatedAt DateTime?
  escalationReason String?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([dealerId, status])
}
