// ══════════ schema.prisma ══════════
// Dastarhan POS — схема БД ядра (Этап 0)
// PostgreSQL + Prisma. Каждое решение прокомментировано ссылкой на урок конкурента.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════ ТЕНАНТ И СТРУКТУРА ═══════════════

// Вертикали (урок Paloma: 6 профилей = одна платформа много рынков)
enum BusinessVertical {
  CAFE      // кафе/ресторан
  FASTFOOD  // фастфуд/столовая/донерная
  SHOP      // магазин/розница
  SALON     // салон красоты
  BILLIARD  // бильярд/караоке/клубы (повременка)
}

model Account {
  id        String   @id @default(cuid())
  /// Налоговый режим заведения. В Казахстане большинство ИП
  /// на упрощёнке — 3% с оборота, без НДС. Крупные ТОО платят НДС.
  taxMode   TaxMode  @default(SIMPLIFIED)
  /// Ставка НДС. С 2026 года в РК — 16% вместо 12%.
  /// Хранится в аккаунте, а не в коде: смена ставки не должна
  /// требовать обновления программы у всех клиентов
  vatRate   Int      @default(16)
  /// Ставка налога с оборота для упрощёнки
  turnoverTaxRate Decimal @default(3)
  name      String
  vertical  BusinessVertical @default(CAFE)
  // Казахстан-поля с 1-го дня (урок Paloma/Poster: локализация = ядро, не плагин)
  binIin    String?  // БИН/ИИН
  language  String   @default("ru") // ru | kk
  currency  String   @default("KZT")
  timezone  String   @default("Asia/Almaty")
  createdAt DateTime @default(now())

  locations Location[]
  users     User[]
  roles     Role[]
}

model Location {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  name      String
  address   String?
  isActive  Boolean @default(true)

  stations    Station[]
  terminals   Terminal[]
  assignments EmployeeAssignment[]

  @@index([accountId])
}

// Касса как устройство: привязана к точке, имеет ключ для sync
// (урок Poster: терминалы синхронизируются; урок r_keeper License: устройство = объект учёта)
model Terminal {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  name       String   // "Касса 1", "Бар"
  deviceKey  String   @unique // секрет устройства для sync-API
  lastSeenAt DateTime?
  isActive   Boolean  @default(true)

  events EventLog[]

  @@index([locationId])
}

// ═══════════════ ЛЮДИ И ДОСТУП ═══════════════

model User {
  id           String  @id @default(cuid())
  accountId    String
  account      Account @relation(fields: [accountId], references: [id])
  fullName     String
  // Бэк-офис: email+пароль. Касса: PIN. Оба опциональны — официант может
  // не иметь входа в офис (урок Poster: сотрудник ≠ пользователь админки)
  email        String? @unique
  passwordHash String?
  pinHash      String? // 4-6 цифр, вход на кассе
  phone        String?
  isOwner      Boolean @default(false)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())

  assignments EmployeeAssignment[]

  @@index([accountId])
}

// Роль назначается ПО ТОЧКАМ (урок Poster access-by-locations:
// один человек — кассир в точке А, менеджер в точке Б)
model EmployeeAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, locationId])
  @@index([locationId])
}

// Роли: системные пресеты + свои (урок QuickResto: готовые роли,
// но права редактируются; пресеты: OWNER, MANAGER, CASHIER, WAITER, COOK, COURIER)
model Role {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  name      String
  preset    String? // код пресета, null = кастомная
  // Права: JSONB { "<permission>": "allowed" | "pin" | "denied" }
  // Три состояния — урок QuickResto («состояние права») + Poster
  // («админ-пароль на опасные действия»: pin = действие требует PIN менеджера)
  permissions Json

  assignments EmployeeAssignment[]

  @@unique([accountId, name])
}

// ═══════════════ ОФЛАЙН-СИНХРОНИЗАЦИЯ (ядро!) ═══════════════

// Журнал событий: касса пишет события локально (SQLite), шлёт при появлении
// сети; сервер применяет идемпотентно по eventId. Это фундамент офлайн-режима
// (главный урок Poster: офлайн — продающая фича, значит архитектурная основа).
model EventLog {
  eventId    String   @id // ULID, генерируется на устройстве
  accountId  String
  terminalId String?
  terminal   Terminal? @relation(fields: [terminalId], references: [id])
  type       String   // "order.created", "payment.accepted", "shift.opened", ...
  payload    Json
  createdAt  DateTime // время на устройстве
  receivedAt DateTime @default(now()) // время на сервере
  applied    Boolean  @default(false)
  applyError String?

  @@index([accountId, receivedAt])
  @@index([terminalId, createdAt])
}

// Сессии бэк-офиса (refresh-токены)
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshHash  String
  userAgent    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([userId])
}


// ══════════ schema_menu.prisma ══════════
// Dastarhan POS — Этап 1: Меню и техкарты (расширение schema.prisma)
// Глубина каждого решения откалибрована по лучшему из 5 конкурентов:
//  - типы номенклатуры и «блюдо vs товар» — Poster (what-is-the-difference)
//  - техкарта с брутто/нетто и потерями — iiko + Poster cost-calculation
//  - ВЕРСИОННОСТЬ техкарт — QuickResto (versionnost): смена рецепта без
//    потери истории себестоимости прошлых продаж
//  - модификаторы с СОБСТВЕННЫМИ техкартами (списывают склад) — Poster
//    examples-of-dish-modifiers (13.7K) + QuickResto modifikatory (66K)
//  - размеры порций/конфигурации — QuickResto konfiguratsii
//  - цены по точкам — Poster updateProductPrice(spot) + QuickResto связки продаж
//  - штрихкоды и фасовки — Paloma (розница) + Poster packs
//  - SERVICE-тип — Paloma (салон/бильярд: услуги без склада)

// ═══════════════ КАТЕГОРИИ ═══════════════

model MenuCategory {
  id        String  @id @default(cuid())
  accountId String
  parentId  String?           // дерево категорий (все 5 поддерживают вложенность)
  parent    MenuCategory?  @relation("CatTree", fields: [parentId], references: [id])
  children  MenuCategory[] @relation("CatTree")
  name      String
  nameKk    String?           // казахское название (ядро локализации)
  color     String?           // цвет плитки на кассе (Poster/QuickResto)
  sortOrder Int     @default(0)
  isDeleted Boolean @default(false)  // soft-delete: восстановление (QR recover*)

  products Product[]
  @@index([accountId, parentId])
}

// ═══════════════ НОМЕНКЛАТУРА ═══════════════

// Урок Poster «блюдо vs товар» + Paloma «услуги»:
// GOODS      — товар: покупается и продаётся как есть (бутылка колы). Склад: штучно.
// DISH       — блюдо: продаётся, списывается ПО ТЕХКАРТЕ.
// PREPACK    — полуфабрикат: НЕ продаётся, имеет техкарту, живёт на складе
//              (соус, тесто). Урок QuickResto polufabrikaty (26K).
// INGREDIENT — ингредиент: только закупается и списывается (мука, мясо).
// SERVICE    — услуга: продаётся, склада нет (стрижка, час бильярда).
enum ProductType {
  GOODS
  DISH
  PREPACK
  INGREDIENT
  SERVICE
}

enum MeasureUnit {
  PCS   // штуки
  KG    // килограммы (хранение в граммах внутри)
  L     // литры (хранение в мл)
  PORTION
}

model Product {
  /// Срок хранения в часах после приготовления или вскрытия.
  /// Салат живёт 12 часов, суп 24, заготовка 72 — просроченное
  /// нельзя подавать, и это вопрос не денег, а здоровья гостей
  shelfLifeHours Int?
  stationId String?          // цех приготовления для KDS
  station   Station? @relation(fields: [stationId], references: [id])
  id         String      @id @default(cuid())
  accountId  String
  categoryId String?
  category   MenuCategory? @relation(fields: [categoryId], references: [id])
  type       ProductType
  name       String
  nameKk     String?
  sku        String?     // артикул
  unit       MeasureUnit @default(PCS)
  // Базовая цена продажи в тиынах (минорные единицы KZT — деньги всегда int!)
  basePrice  Int         @default(0)
  vatRate    Int         @default(16) // НДС КЗ 16% с 2026 (факт из доков iiko)
  imageUrl   String?
  // Пищевая ценность на 100г (QuickResto: «Пищевая ценность блюда»)
  nutrition  Json?       // { kcal, protein, fat, carbs }
  isWeighted Boolean     @default(false) // весовой товар (r_keeper: весовые блюда)
  isDeleted  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  barcodes     Barcode[]
  packs        Pack[]
  techCards    TechCard[]          // версии техкарт (DISH/PREPACK/модификатор)
  prices       ProductPrice[]
  availability ProductAvailability[]
  modifierGroups ProductModifierGroup[]

  @@index([accountId, type])
  @@index([accountId, categoryId])
}

// Штрихкоды: несколько на товар (Paloma/Poster: розница)
model Barcode {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  value     String
  @@unique([productId, value])
  @@index([value])
}

// Фасовки: «ящик 24 бут.» — приход в фасовках, списание в базовых единицах
// (Poster packs: getPack/createPack)
model Pack {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String  // "ящик", "упаковка"
  quantity   Decimal // сколько базовых единиц в фасовке
}

// Цены по точкам: одна позиция может стоить по-разному в разных точках
// (Poster updateProductPrice per spot; QuickResto «связки продаж»)
model ProductPrice {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  locationId String
  price      Int     // тиыны
  @@unique([productId, locationId])
}

// Доступность на точке (продаётся тут или нет) — «связки продаж» QuickResto
model ProductAvailability {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  locationId String
  isForSale  Boolean @default(true)
  @@unique([productId, locationId])
}

// ═══════════════ ТЕХКАРТЫ (С ВЕРСИЯМИ) ═══════════════

// Версионность — ключевая глубина (QuickResto versionnost):
// изменение рецепта создаёт НОВУЮ версию с датой вступления; прошлые продажи
// продолжают считаться по старой версии → история себестоимости не ломается
// (у Poster есть похожее: «редактировать меню задним числом»).
model TechCard {
  id           String   @id @default(cuid())
  productId    String   // владелец: DISH, PREPACK или модификатор
  product      Product  @relation(fields: [productId], references: [id])
  version      Int      // 1, 2, 3...
  effectiveFrom DateTime @default(now()) // с какого момента действует
  // Выход порции в базовых единицах (грамм/мл/шт) — для фудкоста на порцию
  outputQty    Decimal
  note         String?  // технология приготовления (текст для повара)
  createdAt    DateTime @default(now())

  lines TechCardLine[]
  @@unique([productId, version])
  @@index([productId, effectiveFrom])
}

// Строка техкарты: брутто/нетто (урок iiko/Poster):
// брутто — сколько взяли со склада (списание!), нетто — сколько в блюде
// после обработки. Потери = (брутто-нетто)/брутто. Компонентом может быть
// INGREDIENT, GOODS или PREPACK (вложенные техкарты — рекурсивный фудкост).
model TechCardLine {
  id           String   @id @default(cuid())
  techCardId   String
  techCard     TechCard @relation(fields: [techCardId], references: [id])
  componentId  String   // Product.id (INGREDIENT | GOODS | PREPACK)
  bruttoQty    Decimal  // списывается со склада
  nettoQty     Decimal  // остаётся в блюде
  sortOrder    Int      @default(0)
}

// ═══════════════ МОДИФИКАТОРЫ ═══════════════

// Двухуровневая модель (Poster + QuickResto, объединено):
// Группа (например «Молоко») с правилами выбора: minSelect/maxSelect,
// обязательность; в группе — опции. У опции может быть СВОЯ ТЕХКАРТА
// (сироп 20мл списывается со склада!) и своя цена (+200 тг).
model ModifierGroup {
  id        String  @id @default(cuid())
  accountId String
  name      String
  nameKk    String?
  minSelect Int     @default(0)  // 0 = необязательная (QR: «обязательное добавление»)
  maxSelect Int     @default(1)  // 1 = одиночный выбор, >1 = множественный
  isDeleted Boolean @default(false)

  options  ModifierOption[]
  products ProductModifierGroup[]
}

model ModifierOption {
  id           String        @id @default(cuid())
  groupId      String
  group        ModifierGroup @relation(fields: [groupId], references: [id])
  name         String
  nameKk       String?
  priceDelta   Int           @default(0) // тиыны, может быть 0 или отрицательным
  // Списание склада опцией: либо простая связь на компонент+количество,
  // либо полноценная техкарта через отдельный PREPACK-продукт
  componentId  String?       // Product.id для простого списания
  componentQty Decimal?
  isDefault    Boolean       @default(false) // автодобавление (QR: «автоматическое»)
  sortOrder    Int           @default(0)
}

// Привязка групп модификаторов к продуктам (многие-ко-многим)
model ProductModifierGroup {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id])
  sortOrder Int           @default(0)
  @@unique([productId, groupId])
}

// ═══════════════ КОМБО ═══════════════

// Комбо (все 5 имеют): набор слотов, в каждом — выбор из продуктов,
// цена комбо фиксированная или скидочная (Poster: «блюда на выбор и
// фиксированная цена» — паттерн из examples-of-dish-modifiers).
model Combo {
  id        String  @id @default(cuid())
  accountId String
  name      String
  nameKk    String?
  price     Int     // фиксированная цена комбо, тиыны
  isDeleted Boolean @default(false)

  slots ComboSlot[]
}

model ComboSlot {
  id      String @id @default(cuid())
  comboId String
  combo   Combo  @relation(fields: [comboId], references: [id])
  name    String // "Напиток", "Бургер"
  choices Json   // [{productId, priceDelta}] — варианты слота
  sortOrder Int  @default(0)
}


// ══════════ schema_pos.prisma ══════════
// Dastarhan POS — Этап 2: Касса (расширение schema.prisma)
// Глубина по лучшему из 5:
//  - 3 режима обслуживания (зал/навынос/доставка) — Poster order-list
//  - заказ ПО ГОСТЯМ: блюдо принадлежит гостю, переносы блюдо→гость,
//    заказ→стол, заказ→официант, гость→стол — QuickResto perenos (9K)
//  - частичная отправка на кухню, курсы подачи — QuickResto operatsii (10K)
//  - смена: книжный vs фактический баланс, расхождения — Poster expected/actual
//  - стоп-лист с количеством остатка — Poster (+прогноз) / Paloma stop-list
//  - зал: дизайнер столов, цвета состояний — Poster table-color + Paloma дизайнер

// ═══════════════ ЗАЛ И СТОЛЫ ═══════════════

model Hall {
  id         String @id @default(cuid())
  locationId String
  name       String // "Основной зал", "Терраса"
  sortOrder  Int    @default(0)
  tables     DiningTable[]
}

model DiningTable {
  id       String @id @default(cuid())
  hallId   String
  hall     Hall   @relation(fields: [hallId], references: [id])
  name     String // "1", "VIP-2"
  seats    Int    @default(4)
  // Геометрия для дизайнера зала (Paloma «дизайнер столов»)
  x        Int    @default(0)
  y        Int    @default(0)
  shape    String @default("rect") // rect | round
  isActive Boolean @default(true)
  reservations Reservation[]
  orders   Order[]
}

// ═══════════════ ЗАКАЗ ═══════════════

// Режимы обслуживания — Poster: «в заведении, навынос, доставка»
enum ServiceMode {
  DINE_IN
  TAKEOUT
  DELIVERY
}

// Машина состояний заказа (объединение всех 5; DELIVERY-статусы — этап 7)
enum OrderStatus {
  OPEN       // набирается
  CLOSED     // оплачен и закрыт
  CANCELLED  // отменён (право order.cancel, у кассира — под PIN)
}

model Order {
  /// Пречек напечатан — счёт заблокирован от изменений.
  /// Гость видит сумму на бумаге, и она не должна меняться
  /// без ведома старшего
  precheckedAt DateTime?
  unlockedBy   String?
  id          String      @id @default(cuid())
  accountId   String
  locationId  String
  terminalId  String
  shiftId     String
  shift       CashShift   @relation(fields: [shiftId], references: [id])
  number      Int         // человекочитаемый номер в смене
  mode        ServiceMode @default(DINE_IN)
  status      OrderStatus @default(OPEN)
  tableId     String?
  table       DiningTable? @relation(fields: [tableId], references: [id])
  guestsCount Int         @default(1)
  waiterId    String?     // ответственный (перенос заказ→официант — QR)
  comment     String?
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  // Деньги фиксируются на момент закрытия (тиыны)
  subtotal    Int         @default(0)
  discount    Int         @default(0)
  total       Int         @default(0)

  items OrderItem[]

  @@unique([shiftId, number])
  @@index([locationId, status])
}

// Позиция принадлежит ГОСТЮ (номер места) — фундамент переносов и
// разделения счёта по гостям (QuickResto). guestNo=0 — «на стол».
model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String
  nameSnapshot String // имя на момент продажи (меню меняется — чек нет)
  guestNo    Int      @default(0)
  qty        Decimal  @default(1)
  // Цена зафиксирована на момент добавления (урок версионности: история неизменна)
  unitPrice  Int
  modifiers  Json     // [{groupId, optionId, name, priceDelta, componentId, qty}]
  course     Int      @default(1)  // курс подачи (QR «порядок подачи»)
  comment    String?  // комментарий блюду (QR)
  // Кухня: NEW → SENT (частичная отправка — QR «отправить часть заказа»)
  kitchenStatus String @default("NEW") // NEW | SENT | COOKED | SERVED
  sentAt     DateTime?
  isRemoved  Boolean  @default(false) // удаление под PIN — след остаётся!
  removedBy  String?
  removedReason String?

  @@index([orderId])
}

// ═══════════════ СТОП-ЛИСТ ═══════════════

// Poster: стоп-лист с остатком порций (не просто вкл/выкл — «осталось 3»)
model StopListEntry {
  id         String   @id @default(cuid())
  locationId String
  productId  String
  // null = полностью в стопе; число = осталось порций, авто-декремент при продаже
  remainingQty Decimal?
  reason     String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@unique([locationId, productId])
}

// ═══════════════ КАССОВАЯ СМЕНА ═══════════════

// Poster expected/actual: книжный баланс считается системой, фактический
// вводится при закрытии; расхождение фиксируется и видно в отчётах.
model CashShift {
  id            String    @id @default(cuid())
  accountId     String
  locationId    String
  terminalId    String
  number        Int       // сквозной номер смены терминала
  openedBy      String
  openedAt      DateTime  @default(now())
  openingCash   Int       // размен на старте, тиыны
  closedBy      String?
  closedAt      DateTime?
  // На закрытии:
  expectedCash  Int?      // книжный = opening + налич.продажи + внесения − изъятия − налич.возвраты
  actualCash    Int?      // фактический (пересчёт кассиром)
  discrepancy   Int?      // actual − expected (может быть ±)
  note          String?

  orders       Order[]
  transactions CashTransaction[]

  @@unique([terminalId, number])
  @@index([locationId, openedAt])
}

// Внесения/изъятия (Poster: «расход, внесение, инкассация»)
enum CashTxType {
  CASH_IN
  CASH_OUT
  COLLECTION // инкассация
}

model CashTransaction {
  id       String     @id @default(cuid())
  shiftId  String
  shift    CashShift  @relation(fields: [shiftId], references: [id])
  type     CashTxType
  amount   Int        // тиыны, всегда > 0; знак определяется типом
  reason   String?
  byUserId String
  at       DateTime   @default(now())

  @@index([shiftId])
}


// ══════════ schema_payments.prisma ══════════
// Dastarhan POS — Этап 3: Оплаты и фискализация КЗ
// Глубина по лучшему из 5:
//  - смешанная оплата несколькими типами + отмена частичной — QuickResto oplata
//  - выбор фискального провайдера (не один!) — Paloma (5 провайдеров)
//  - «какие операции фискализировать — выбирает владелец» — Poster fiscalization
//  - интерфейс драйвера sell/refund с errorCode — Poster dev device/fiscal
//  - Kaspi: сумма летит на терминал автоматически; конфликт с Kaspi Kassa
//    задокументирован — Paloma kaspi-terminal
//  - ОФЛАЙН-фискализация: чек уходит в очередь и пробивается при сети
//    (Poster: печать чеков офлайн; Webkassa API это позволяет)

// ═══════════════ СПОСОБЫ ОПЛАТЫ ═══════════════

enum PayKind {
  CASH        // наличные (сдача!)
  CARD        // банковский терминал (Kaspi/Halyk/Forte — интеграция суммы)
  KASPI_QR    // Kaspi QR на экране кассы
  BONUS       // бонусами (Этап 6 — каркас сейчас)
  TRANSFER    // перевод/прочее (настраиваемые типы — у всех 5 есть «свои типы»)
}

// Настраиваемый способ оплаты точки (владелец создаёт свои — Poster
// how-to-create-a-new-order-payment-method)
model PaymentMethod {
  id         String  @id @default(cuid())
  accountId  String
  name       String            // «Наличные», «Kaspi терминал», «Halyk»
  kind       PayKind
  // Привязка к железу/интеграции (терминал Kaspi этой кассы и т.п.)
  driver     String?           // 'kaspi_terminal' | 'halyk_terminal' | 'kaspi_qr' | null
  // Фискализировать ли операции этим способом (Poster: владелец выбирает)
  fiscalize  Boolean @default(true)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)
}

// ═══════════════ ПЛАТЕЖИ ЗАКАЗА ═══════════════

enum PaymentStatus {
  PENDING    // создан (например, ждём ответ терминала)
  CAPTURED   // деньги получены
  FAILED
  VOIDED     // отменён при частичной оплате (QR: «отменить транзакцию»)
  REFUNDED   // возвращён (частично/полностью — через Refund)
}

model Payment {
  /// Отмена оплаты картой. Система только фиксирует —
  /// сам возврат делается на банковском терминале
  voidedAt   DateTime?
  voidReason String?
  id         String        @id @default(cuid())
  orderId    String
  methodId   String
  kind       PayKind
  amount     Int           // тиыны; для CASH — сумма К ЗАЧЁТУ (не полученная!)
  tendered   Int?          // CASH: сколько дал гость; сдача = tendered − amount
  status     PaymentStatus @default(PENDING)
  // Ссылка на транзакцию внешней системы (RRN терминала, id Kaspi QR)
  externalRef String?
  createdAt  DateTime      @default(now())
  capturedAt DateTime?

  refunds Refund[]
  @@index([orderId])
}

model Refund {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  amount     Int
  reason     String   // причина обязательна (правило этапа 2)
  byUserId   String
  createdAt  DateTime @default(now())
  fiscalId   String?  // ссылка на фискальный чек возврата
}

// ═══════════════ ФИСКАЛИЗАЦИЯ ═══════════════

// Провайдер аккаунта: выбор из нескольких (Paloma-модель). credentials — JSONB
// (токены/ключи Webkassa|reKassa). При росте добавляем провайдеров без миграций.
model FiscalProvider {
  id         String  @id @default(cuid())
  accountId  String
  locationId String?          // можно свой провайдер на точку
  type       String           // 'webkassa' | 'rekassa' | 'noop'
  credentials Json
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)
}

enum FiscalOp {
  SELL
  REFUND
}
enum FiscalStatus {
  QUEUED     // офлайн/ожидает
  SENT       // пробит успешно
  ERROR      // ошибка провайдера (ретраи)
  SKIPPED    // способ оплаты без фискализации
}

// Очередь фискализации — ключ офлайн-надёжности: продажа НЕ блокируется
// недоступностью Webkassa; чек догоняется с ретраями и backoff.
model FiscalReceipt {
  id          String       @id @default(cuid())
  accountId   String
  orderId     String
  op          FiscalOp
  providerId  String
  // Слепок данных чека (позиции, суммы, НДС) — неизменен после создания
  payload     Json
  status      FiscalStatus @default(QUEUED)
  attempts    Int          @default(0)
  nextTryAt   DateTime?
  // Ответ провайдера: номер фискального чека, ссылка ОФД, QR
  fiscalNumber String?
  ofdUrl       String?
  error        String?
  createdAt   DateTime     @default(now())
  sentAt      DateTime?

  @@index([status, nextTryAt])
  @@index([orderId])
}


// ══════════ schema_stock.prisma ══════════
// Dastarhan POS — Этап 4: Склад
// Глубина по лучшему из 5:
//  - документная модель с проведением DRAFT→POSTED — Paloma («что такое
//    проведение документов») + QuickResto (все акты проводятся)
//  - типы документов — объединение всех: приход, списание, перемещение,
//    инвентаризация, производство, разделка/переработка, возврат поставщику,
//    оприходование излишков — QuickResto akty + Paloma документы
//  - себестоимость: скользящая средневзвешенная при приходе — Poster
//    how-the-cost-is-calculated
//  - ИНВЕНТАРИЗАЦИЯ БЕЗ ОСТАНОВКИ ПРОДАЖ: точка отсчёта + операции во время
//    пересчёта учитываются — Paloma (уникальная фича, берём как стандарт)
//  - отрицательные остатки РАЗРЕШЕНЫ (5−8=−3) — Paloma «актуализация»:
//    продажа никогда не блокируется складом (совпадает с офлайн-философией)
//  - ledger-архитектура: остаток = сумма движений; StockBalance — кэш

// ═══════════════ СКЛАДЫ ═══════════════

model Warehouse {
  id         String  @id @default(cuid())
  locationId String
  name       String  // «Кухня», «Бар», «Основной»
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)
}

// ═══════════════ ДОКУМЕНТЫ ═══════════════

enum StockDocType {
  SUPPLY        // приход от поставщика
  WRITEOFF      // списание с причиной (порча/бой/угощение)
  SALE          // авто-списание по продажам (агрегат за смену или по чеку)
  TRANSFER      // перемещение склад→склад
  INVENTORY     // инвентаризация (снимок + корректировка)
  PRODUCTION    // производство: списать ингредиенты ПФ → оприходовать ПФ
  BUTCHERING    // разделка/переработка: списать целое → оприходовать части
  SUPPLIER_RETURN // возврат поставщику
  SURPLUS       // оприходование излишков
}

enum StockDocStatus {
  DRAFT
  POSTED    // проведён — движения созданы
  VOIDED    // распроведён (движения сторнированы)
}

model StockDoc {
  id          String         @id @default(cuid())
  accountId   String
  locationId  String
  type        StockDocType
  status      StockDocStatus @default(DRAFT)
  number      Int
  warehouseId String         // основной склад документа
  // TRANSFER: склад-получатель
  toWarehouseId String?
  supplierId  String?        // SUPPLY/SUPPLIER_RETURN (контрагенты — Этап 5)
  // INVENTORY: точка отсчёта пересчёта (механизм Paloma «без остановки»)
  countStartedAt DateTime?
  reason      String?        // WRITEOFF: причина обязательна
  note        String?
  createdBy   String
  createdAt   DateTime       @default(now())
  postedAt    DateTime?

  lines StockDocLine[]
  @@index([accountId, locationId, type])
  @@unique([locationId, type, number])
}

model StockDocLine {
  id        String   @id @default(cuid())
  docId     String
  doc       StockDoc @relation(fields: [docId], references: [id])
  productId String
  qty       Decimal  // в базовых единицах; для INVENTORY = ФАКТ пересчёта
  // SUPPLY: цена закупки за единицу (тиыны) — источник себестоимости
  unitCost  Int?
  // BUTCHERING: роль строки: INPUT (туша) | OUTPUT (части)
  role      String?  // 'IN' | 'OUT' (для PRODUCTION/BUTCHERING)
  sortOrder Int      @default(0)

  @@index([docId])
}

// ═══════════════ ДВИЖЕНИЯ (LEDGER) ═══════════════

// Каждое проведение документа порождает движения ±. Остаток склада =
// Σ движений. Это даёт полный аудит «откуда взялась цифра» (боль всех
// конкурентов — «почему остаток такой?» — у нас разложимо по движениям).
model StockMovement {
  id          String   @id @default(cuid())
  accountId   String
  warehouseId String
  productId   String
  docId       String?  // источник (null для авто-продаж до агрегации)
  orderId     String?  // для SALE-списаний — связь с чеком
  qtyDelta    Decimal  // + приход, − расход
  // Себестоимость единицы на момент движения (для расходов — текущая средняя)
  unitCost    Int
  at          DateTime @default(now())

  @@index([warehouseId, productId, at])
  @@index([docId])
}

// Кэш остатков и средней себестоимости (пересчитывается при проведении)
model StockBalance {
  id          String  @id @default(cuid())
  warehouseId String
  productId   String
  qty         Decimal @default(0)  // МОЖЕТ БЫТЬ ОТРИЦАТЕЛЬНЫМ (Paloma 5−8=−3)
  avgCost     Int     @default(0)  // средневзвешенная, тиыны за единицу

  @@unique([warehouseId, productId])
}


// ══════════ schema_finance.prisma ══════════
// Dastarhan POS — Этап 5: Финансы и отчёты
// Глубина по лучшему из 5:
//  - счета + статьи (виды) + транзакции — QuickResto «Финансы» (15K)
//  - Cash Flow: движение денег и остатки счетов на дату — Poster (5.6K)
//  - P&L ПО НАЧИСЛЕНИЮ vs CF ПО ДЕНЬГАМ: различие — методичка Poster
//    «почему суммы в отчётах расходятся»; у нас оба отчёта из одних данных
//  - ABC с учётом акций/бесплатных чеков — Poster (анализ по марже, не только
//    по выручке — иначе акционные товары искажают картину)
//  - RFM-анализ клиентов — QuickResto (каркас; наполнение в Этапе 6)
//  - зарплата: правила на ДОЛЖНОСТЬ с переопределением на СОТРУДНИКА —
//    QuickResto salary-setup; ставки: оклад/час/% продаж
//  - предвидение КЗ: поле taxRegime у аккаунта (упрощёнка 3% — реалия малого
//    бизнеса КЗ; конкуренты этого не считают, мы покажем налог сразу в P&L)

// ═══════════════ ДЕНЬГИ ═══════════════

// Счёт: наличная касса точки, банковский счёт, Kaspi Pay и т.д.
model FinAccount {
  id         String  @id @default(cuid())
  accountId  String  // тенант
  locationId String? // null = общий для бизнеса
  name       String  // «Касса», «Halyk счёт», «Kaspi Pay»
  kind       String  // 'cash' | 'bank' | 'kaspi' | 'other'
  openingBalance Int @default(0) // тиыны
  isActive   Boolean @default(true)
}

// Статья движения (QuickResto «виды статей»): доход / расход / перевод
enum FinCatKind {
  INCOME
  EXPENSE
  TRANSFER
}

model FinCategory {
  id        String     @id @default(cuid())
  accountId String
  name      String     // «Выручка», «Закупка продуктов», «Аренда», «Зарплата»
  kind      FinCatKind
  // Участвует ли в P&L (переводы между счетами — нет!)
  inPnl     Boolean    @default(true)
  isSystem  Boolean    @default(false) // системные не удалить
}

model FinTransaction {
  id           String   @id @default(cuid())
  accountId    String
  finAccountId String   // счёт
  categoryId   String
  amount       Int      // тиыны, всегда > 0; знак задаёт kind категории
  // Для TRANSFER: счёт-получатель (двойная запись одной транзакцией)
  toFinAccountId String?
  // Привязки к источникам (авто-транзакции)
  orderId    String?    // выручка от закрытия заказа
  supplyDocId String?   // оплата поставки
  shiftId    String?    // инкассация смены
  note       String?
  byUserId   String
  at         DateTime   @default(now())

  @@index([accountId, at])
  @@index([finAccountId, at])
}

// ═══════════════ ТАБЕЛЬ И ЗАРПЛАТА ═══════════════

// Рабочая смена сотрудника (вход/выход по PIN на кассе = УРВ Paloma)
model EmployeeShift {
  id         String    @id @default(cuid())
  accountId  String
  locationId String
  userId     String
  clockIn    DateTime
  clockOut   DateTime?
  // Часы могут корректироваться менеджером (спорные случаи)
  adjustedMinutes Int?
  note       String?

  @@index([accountId, userId, clockIn])
}

// Правило оплаты: на РОЛЬ (должность) с переопределением на СОТРУДНИКА
// (модель QuickResto). Компоненты суммируются: оклад + час + % продаж.
model SalaryRule {
  id         String  @id @default(cuid())
  accountId  String
  roleId     String? // правило должности
  userId     String? // переопределение сотрудника (приоритетнее)
  monthlyBase Int    @default(0) // оклад за месяц, тиыны
  hourlyRate  Int    @default(0) // за час
  salesPct    Decimal @default(0) // % от ЛИЧНЫХ продаж (официанты)
}

// Начисление за период (расчёт → выплата транзакцией FinTransaction)
model SalaryAccrual {
  id        String   @id @default(cuid())
  accountId String
  userId    String
  periodFrom DateTime
  periodTo   DateTime
  baseAmount  Int @default(0)
  hourlyAmount Int @default(0)
  salesAmount  Int @default(0)
  bonusAmount  Int @default(0) // премии/штрафы вручную (может быть <0)
  total        Int
  paidTxId   String? // ссылка на транзакцию выплаты
  createdAt  DateTime @default(now())
}


// ══════════ schema_guests.prisma ══════════
// Dastarhan POS — Этап 6: Гости и лояльность
// Глубина по лучшему из 5:
//  - клиент: идентификаторы (телефон/карта), группы, история — QuickResto (12.6K)
//  - бонусы: % начисления по группам, оплата с лимитом % чека — QR + iikoCard
//  - депозит И ДОЛГ: Paloma депозитно-долговая («запиши на меня» — реальная
//    практика КЗ, никто кроме Paloma не делает — берём и углубляем лимитом)
//  - палитра акций — QuickResto offers (20K): спецпредложение, N+1/подарок,
//    промокод (обычный и РАСХОДУЕМЫЙ), абонемент, подарок от суммы
//  - временные скидки (happy hours) — Paloma «временная скидка»
//  - QR-меню стола и Telegram-бот — QuickResto (19 статей) как образец,
//    оплата — Kaspi (наш козырь, у QR только росс. процессинги)

// ═══════════════ КЛИЕНТЫ ═══════════════

model Customer {
  id        String   @id @default(cuid())
  accountId String
  // Телефон — главный ID в КЗ (нормализованный +7 7XX XXX XX XX)
  phone     String
  name      String?
  birthday  DateTime?
  cardNumber String? // физическая карта лояльности (опционально)
  groupId   String?
  group     CustomerGroup? @relation(fields: [groupId], references: [id])
  // Telegram-привязка (бот Этапа 6)
  telegramChatId String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  bonusTxs   BonusTx[]
  depositTxs DepositTx[]
  @@unique([accountId, phone])
  @@index([accountId, groupId])
}

// Группы: «Свои», «VIP», «Сотрудники» — скидка/бонус % на группу (QR)
model CustomerGroup {
  id           String @id @default(cuid())
  accountId    String
  name         String
  discountPct  Decimal @default(0)  // автоскидка группы
  bonusPct     Decimal @default(0)  // % начисления бонусов группе
  customers    Customer[]
}

// ═══════════════ БОНУСЫ ═══════════════

// Программа аккаунта: базовый % начисления, лимит оплаты бонусами (% чека),
// срок жизни бонусов (сгорание) — объединение QR + iikoCard.
model BonusProgram {
  id            String  @id @default(cuid())
  accountId     String  @unique
  accrualPct    Decimal @default(5)   // % от чека ПОСЛЕ скидок
  maxPayPct     Decimal @default(50)  // бонусами можно закрыть до N% чека
  expireDays    Int?                  // null = не сгорают
  isActive      Boolean @default(true)
}

// Движения бонусов (ledger — как склад: баланс = Σ движений, полный аудит)
enum BonusTxType {
  ACCRUAL
  PAYMENT
  EXPIRE
  MANUAL
}

model BonusTx {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  type       BonusTxType
  amount     Int         // тиыны; + начисление, − списание
  orderId    String?
  expiresAt  DateTime?   // для ACCRUAL при сгорании
  note       String?
  at         DateTime    @default(now())
  @@index([customerId, at])
}

// ═══════════════ ДЕПОЗИТ И ДОЛГ (Paloma-модель, углублена) ═══════════════

// Единый кошелёк: баланс > 0 — депозит, < 0 — долг (в пределах creditLimit).
enum DepositTxType {
  TOPUP
  PAYMENT
  REFUND
  DEBT_REPAY
  MANUAL
}

model CustomerWallet {
  id          String @id @default(cuid())
  customerId  String @unique
  creditLimit Int    @default(0) // 0 = долг запрещён; >0 — «запиши на меня» до лимита
}

model DepositTx {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  type       DepositTxType
  amount     Int           // + пополнение/возврат, − оплата
  orderId    String?
  byUserId   String
  at         DateTime      @default(now())
  @@index([customerId, at])
}

// ═══════════════ СКИДКИ И АКЦИИ ═══════════════

// Скидка: ручная (право order.discount.manual) или автоматическая по условиям.
// Временное окно — happy hours (Paloma «временная скидка»).
model Discount {
  id        String  @id @default(cuid())
  accountId String
  name      String
  pct       Decimal            // % на чек или позиции категории
  categoryId String?           // null = весь чек
  // Окно действия (happy hours): дни недели + часы
  daysMask  Int     @default(127) // битовая маска Пн..Вс (127 = все)
  fromMin   Int?    // минуты от полуночи, null = весь день
  toMin     Int?
  isActive  Boolean @default(true)
}

// Акции — палитра QuickResto offers:
enum PromoType {
  N_PLUS_GIFT   // каждый N-й товар бесплатно (3-й кофе)
  GIFT_FROM_SUM // подарок от суммы заказа
  PROMOCODE     // код: % или сумма; расходуемый (лимит использований)
  SUBSCRIPTION  // абонемент: N использований товара (кофе-абонемент)
}

model Promo {
  id        String    @id @default(cuid())
  accountId String
  type      PromoType
  name      String
  config    Json      // параметры типа: {n, productId} | {minSum, giftProductId} | {code, pct?, amount?, maxUses?} | {productId, uses}
  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean   @default(true)

  uses PromoUse[]
}

model PromoUse {
  id         String   @id @default(cuid())
  promoId    String
  promo      Promo    @relation(fields: [promoId], references: [id])
  customerId String?
  orderId    String
  at         DateTime @default(now())
  @@index([promoId])
}

// ═══════════════ ГОСТЕВЫЕ КАНАЛЫ ═══════════════

// QR-меню: токен стола → ссылка меню/заказа (Poster QR / QR Showcase)
model QrTableToken {
  id       String @id @default(cuid())
  tableId  String @unique
  token    String @unique // короткий, в QR-наклейке на столе
}

// Telegram-бот точки (конструктор — образец QR, 19 статей; оплата Kaspi)
model TelegramBot {
  id         String  @id @default(cuid())
  accountId  String  @unique
  botToken   String  // токен BotFather
  welcomeText String?
  isActive   Boolean @default(true)
}


// ══════════ schema_delivery.prisma ══════════
// Dastarhan POS — Этап 7: Доставка
// Глубина по лучшему из 5 (главный образец — r_keeper Delivery, 618 статей):
//  - статусная машина с ОБЯЗАТЕЛЬНЫМ ядром + настраиваемые имена, строгий
//    порядок — r_keeper «Статусы заказа»
//  - зоны = ПОЛИГОНЫ, могут пересекаться (разные минималки/цены/время);
//    выбирается лучшая для клиента — r_keeper «Зоны доставок»
//  - курьеры: назначение, рейс из нескольких заказов, приложение курьера,
//    РАСЧЁТ С КУРЬЕРОМ (наличные у курьера = его долг до сдачи в кассу) —
//    r_keeper «Расчёт с курьерами» + отчёты по курьерам
//  - вебхуки на смену статуса (интеграции) — r_keeper «Подписка на статусы»
//  - promise time и просрочка (тепловая карта как метрика) — r_keeper
//  - агрегаторы: адаптер Wolt/Glovo/Kwaaka (набор КЗ — Paloma/Poster)

// ═══════════════ ДОСТАВОЧНЫЙ ЗАКАЗ ═══════════════

// Расширение Order (mode=DELIVERY) деталями доставки
model DeliveryInfo {
  id        String   @id @default(cuid())
  orderId   String   @unique
  customerId String?          // клиент из Этапа 6 (телефон!)
  phone     String            // телефон получателя (нормализованный)
  address   String
  lat       Decimal?
  lng       Decimal?
  zoneId    String?
  comment   String?
  // Время: ближайшее или к сроку (r_keeper: предзаказы)
  scheduledAt DateTime?       // null = как можно скорее
  promisedAt  DateTime        // обещанное время (SLA; просрочка = метрика)
  deliveryFee Int   @default(0) // тиыны, по зоне
  courierId   String?
  tripId      String?
  // Источник: own | wolt | glovo | kwaaka | telegram | qr
  source      String @default("own")
  externalId  String?         // id заказа в агрегаторе
  status      String @default("NEW") // машина статусов ниже (в логике)
  statusLog   Json   @default("[]")  // [{status, at, byUserId}]
}

// ═══════════════ ЗОНЫ (полигоны, r_keeper) ═══════════════

model DeliveryZone {
  id         String  @id @default(cuid())
  locationId String
  name       String
  // Полигон: [[lat,lng],...] — зоны МОГУТ пересекаться (r_keeper);
  // при попадании в несколько выбирается лучшая для клиента (логика)
  polygon    Json
  minOrder   Int     @default(0)     // минимальная сумма заказа
  deliveryFee Int    @default(0)     // стоимость доставки
  freeFrom   Int?                    // бесплатно от суммы (null = никогда)
  etaMinutes Int     @default(60)    // обещание времени для зоны
  isActive   Boolean @default(true)
  priority   Int     @default(0)     // при равной цене — выше приоритет
}

// ═══════════════ КУРЬЕРЫ ═══════════════

model Courier {
  id         String  @id @default(cuid())
  accountId  String
  userId     String  @unique  // сотрудник с ролью COURIER (Этап 0)
  transport  String  @default("foot") // foot | bike | car
  isOnline   Boolean @default(false)
  lastLat    Decimal?
  lastLng    Decimal?
  lastSeenAt DateTime?
}

// Рейс: курьер везёт НЕСКОЛЬКО заказов за выезд (r_keeper: назначение)
model CourierTrip {
  id        String   @id @default(cuid())
  courierId String
  startedAt DateTime @default(now())
  closedAt  DateTime?
  // Наличные, собранные в рейсе − сданные в кассу = долг курьера
  cashCollected Int @default(0)
  cashReturned  Int @default(0)
}

// ═══════════════ ВЕБХУКИ СТАТУСОВ (r_keeper «подписка») ═══════════════

model DeliveryWebhook {
  id        String  @id @default(cuid())
  accountId String
  url       String
  // Какие статусы слать (пусто = все)
  statuses  Json    @default("[]")
  secret    String
  isActive  Boolean @default(true)
}

// ═══════════════ АГРЕГАТОРЫ ═══════════════

// Подключение агрегатора точки: адаптер по типу, ключи в credentials
model AggregatorLink {
  id         String  @id @default(cuid())
  locationId String
  type       String  // 'wolt' | 'glovo' | 'kwaaka' | 'yandex' (тип = адаптер)
  credentials Json
  // Меню-синк: пушить ли стоп-лист и цены (у всех агрегаторов КЗ есть API)
  syncStopList Boolean @default(true)
  isActive   Boolean @default(true)
}


// ══════════ schema_ai.prisma ══════════
// Dastarhan POS — Этап 8: ИИ-модуль («Данакер» — рабочее имя ассистента)
// Единственный образец на рынке — Postie AI (Poster), 4 функции:
//   1) фото накладной → поставка; 2) выписка CSV/XLS/PDF → транзакции
//   по категориям; 3) аналитика по текстовому вопросу; 4) фудкост-контроль.
// Наши углубления против Postie:
//   - ЧЕРНОВИК-ПРИНЦИП: ИИ никогда не проводит документы сам — только
//     готовит черновик с confidence; человек подтверждает (доверие = продажи)
//   - матчинг позиций к номенклатуре с прозрачным скорингом (у Postie
//     «магия», у нас — объяснимо: почему сматчилось)
//   - выписки Kaspi Pay/Halyk — казахстанские мерчанты в категоризации
//     (у Postie нет КЗ-специфики)
//   - фудкост-сигналы — не LLM, а детерминированные правила (дёшево, надёжно);
//     LLM подключается только там, где нужен интеллект (парсинг, язык)
// Движок: Claude API (vision для фото, structured output для парсинга).

enum AiJobType {
  INVOICE_PHOTO   // фото/скан накладной → черновик SUPPLY
  BANK_STATEMENT  // PDF/CSV выписка (Kaspi/Halyk/любой) → транзакции
  REPORT_QUERY    // текстовый вопрос → параметры отчёта + ответ
  MENU_IMPORT     // фото меню конкурента/своего → черновик номенклатуры
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  READY       // черновик готов, ждёт подтверждения человеком
  CONFIRMED   // человек принял (возможно, с правками) → документ создан
  REJECTED    // человек отклонил (фидбек для улучшения промптов)
  FAILED
}

model AiJob {
  id         String      @id @default(cuid())
  accountId  String
  locationId String?
  type       AiJobType
  status     AiJobStatus @default(QUEUED)
  // Вход: ссылка на файл (S3) или текст запроса
  inputFileUrl String?
  inputText    String?
  // Выход: структурированный черновик (формат зависит от type)
  draft      Json?
  // Уверенность 0..1 по строкам и в целом; низкая — подсветка в UI
  confidence Decimal?
  // Правки человека при подтверждении (обучающий сигнал)
  humanEdits Json?
  resultDocId String?   // созданный документ после CONFIRMED
  error      String?
  byUserId   String
  createdAt  DateTime @default(now())
  doneAt     DateTime?

  @@index([accountId, type, status])
}

// Память матчинга: «Молоко Отборное 3.2% 1л» у этого поставщика = наш продукт X.
// Один раз подтвердил — дальше матчится мгновенно и точно (у Postie нет).
model AiItemAlias {
  id         String @id @default(cuid())
  accountId  String
  supplierId String?
  rawName    String   // как в накладной
  productId  String   // наш продукт
  @@unique([accountId, supplierId, rawName])
}

// Правила категоризации выписок: мерчант → категория ДДС.
// Предзаполнены казахстанскими (Magnum, Small, КазТрансГаз, Алматы Су...),
// пополняются подтверждениями пользователя.
model AiMerchantRule {
  id         String @id @default(cuid())
  accountId  String? // null = глобальное правило платформы
  pattern    String  // подстрока/regex по назначению платежа
  categoryName String
  @@index([accountId])
}


// ══════════ schema_verticals.prisma ══════════
// Dastarhan POS — Этап 9: Вертикали (Магазин / Салон / Бильярд-Караоке)
// Единственный образец мультивертикальности — Paloma (6 профилей), но её
// глубина — онбординг-статьи. Мы делаем ГЛУБЖЕ образца:
//  - МАГАЗИН: весовые штрихкоды EAN-13 (префикс 22/23 — стандарт весов СНГ,
//    Paloma лишь «печать этикеток на весовой товар»), быстрая касса сканером,
//    этикетки, НКТ-коды (обязательны в КЗ) — поле уже в Barcode/Product
//  - САЛОН: записи к мастеру (календарь, длительность услуги, запрет
//    double-booking), % мастера — уже умеет SalaryRule.salesPct (Этап 5)
//  - БИЛЬЯРД/КАРАОКЕ/САУНА (Paloma-профиль): ПОВРЕМЕНКА — ресурс (стол/
//    комната), тарифные окна (день/вечер/ночь), поминутный биллинг с
//    пересечением окон, минимум и шаг округления; сессия закрывается
//    SERVICE-позицией в обычный заказ (вся касса/оплаты/фискализация — даром)
// Профиль вертикали (Account.vertical, Этап 0) включает модули в UI.

// ═══════════════ САЛОН: ЗАПИСИ ═══════════════

// Мастер = User; его услуги и график
model MasterProfile {
  id         String @id @default(cuid())
  userId     String @unique
  locationId String
  // Рабочие часы по дням недели: [{dow:0..6, fromMin, toMin}]
  schedule   Json   @default("[]")
  isActive   Boolean @default(true)
}

// Услуга (Product type=SERVICE) получает длительность
model ServiceDetails {
  id          String @id @default(cuid())
  productId   String @unique
  durationMin Int    @default(60)
  // Мастера, оказывающие услугу (пусто = все)
  masterIds   Json   @default("[]")
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  DONE
  NO_SHOW
  CANCELLED
}

model Appointment {
  id         String   @id @default(cuid())
  accountId  String
  locationId String
  masterId   String   // userId мастера
  customerId String?
  serviceId  String   // productId услуги
  startAt    DateTime
  endAt      DateTime // startAt + duration (фикс на момент записи)
  status     AppointmentStatus @default(BOOKED)
  orderId    String?  // заказ, созданный по факту оказания
  note       String?
  createdAt  DateTime @default(now())

  @@index([locationId, masterId, startAt])
}

// ═══════════════ ПОВРЕМЕНКА: РЕСУРСЫ И СЕССИИ ═══════════════

// Ресурс: бильярдный стол, караоке-комната, сауна, PC-место
model TimedResource {
  id         String @id @default(cuid())
  locationId String
  name       String  // «Стол 1», «VIP-комната»
  // Тарифные окна: [{dow mask, fromMin, toMin, pricePerHour(тиыны)}]
  tariffs    Json
  // Правила округления
  minChargeMin Int  @default(30) // минимум к оплате
  stepMin      Int  @default(5)  // шаг округления вверх
  // SERVICE-продукт, которым сессия попадает в заказ (фискализация!)
  serviceProductId String
  isActive   Boolean @default(true)
}

enum TimedSessionStatus {
  RUNNING
  PAUSED
  FINISHED
  CANCELLED
}

model TimedSession {
  id         String   @id @default(cuid())
  resourceId String
  orderId    String?  // сессия прикрепляется к открытому заказу стола
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  // Паузы: [{from, to}] — «поставили на паузу, ушли есть» (глубина, которой
  // нет у Paloma: гость не платит за перерыв)
  pauses     Json     @default("[]")
  status     TimedSessionStatus @default(RUNNING)
  // Итог на закрытии
  billedMinutes Int?
  amount        Int?  // тиыны
  byUserId   String
}


// ══════════ schema_platform.prisma ══════════
// Dastarhan POS — Этап 10 (финальный): Платформа продаж
// Глубина по лучшему из 5:
//  - подписочные лицензии (SAAS + с периодом) — r_keeper License («Генерация
//    лицензий по подписке», справочники Корпорации/Дилеры/Объекты)
//  - дилерская машина: демо-стенды, Service Desk, ЭСКАЛАЦИЯ заявок с
//    автодобавлением руководителей — r_keeper Fordealers (учебник модели)
//  - простая формула цены: «каждая точка = ещё один тариф, включает 1 кассу»
//    — Poster (против зоопарка лицензий r_keeper — мы за простоту Poster)
// Наши углубления:
//  - GRACE-ПЕРИОД с деградацией, а не рубильником: касса офлайн-первая и
//    ОБЯЗАНА продолжать пробивать чеки; при неоплате сначала read-only
//    бэк-офис, касса живёт grace-дней — доверие и закон (чек нельзя не дать!)
//  - дилерская комиссия = % ОТ ПОДПИСКИ ЕЖЕМЕСЯЧНО (recurring share) — у
//    r_keeper дилер зарабатывает на внедрении, у нас на LTV → дилер
//    заинтересован, чтобы клиент ЖИЛ долго
//  - PRORATION при смене тарифа посреди периода — честный перерасчёт

// ═══════════════ ТАРИФЫ ═══════════════

model Plan {
  id        String @id @default(cuid())
  code      String @unique // 'start' | 'standard' | 'pro'
  name      String
  pricePerLocationMonth Int  // тиыны; Poster-формула: цена × точки
  // Лимиты на ТОЧКУ
  terminalsPerLocation Int  @default(1)
  // Модули по тарифу (JSON-флаги: ai, delivery, loyalty, verticals...)
  modules   Json
  isActive  Boolean @default(true)
}

// ═══════════════ ПОДПИСКА ═══════════════

enum SubStatus {
  TRIAL      // 14 дней полного функционала
  ACTIVE
  PAST_DUE   // не оплачено: бэк-офис read-only, касса работает (grace)
  SUSPENDED  // grace истёк: касса read-only (открытые смены закрыть можно)
  CANCELLED
}

model Subscription {
  id         String    @id @default(cuid())
  accountId  String    @unique
  planId     String
  status     SubStatus @default(TRIAL)
  locationsCount Int   @default(1)   // оплаченное число точек
  periodStart DateTime
  periodEnd   DateTime
  trialEnd    DateTime?
  graceDays   Int      @default(7)
  dealerId    String?  // продавший/сопровождающий дилер
  createdAt  DateTime  @default(now())

  payments SubPayment[]
}

model SubPayment {
  id        String   @id @default(cuid())
  subId     String
  sub       Subscription @relation(fields: [subId], references: [id])
  amount    Int
  method    String   // 'kaspi' | 'invoice' | 'card'
  periodFrom DateTime
  periodTo   DateTime
  at        DateTime @default(now())
}

// ═══════════════ ДИЛЕРЫ (r_keeper Fordealers, углублено) ═══════════════

model Dealer {
  id         String @id @default(cuid())
  name       String
  binIin     String
  region     String   // города/области КЗ
  // Recurring-комиссия: % от подписок его клиентов КАЖДЫЙ месяц
  commissionPct Decimal @default(20)
  contactPhone String
  isActive   Boolean @default(true)

  demoAccounts DemoAccount[]
}

// Демо-стенды (r_keeper): дилер разворачивает демо клиенту в 1 клик, TTL
model DemoAccount {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id])
  accountId String   @unique // полноценный аккаунт с демо-данными вертикали
  vertical  String
  expiresAt DateTime // авто-очистка
  convertedAt DateTime? // стал платящим — засчитан дилеру
  createdAt DateTime @default(now())
}

// Начисления дилеру (по оплатам подписок его клиентов)
model DealerAccrual {
  id        String   @id @default(cuid())
  dealerId  String
  subPaymentId String @unique
  amount    Int      // тиыны = payment × commissionPct
  paidAt    DateTime?
  createdAt DateTime @default(now())
}

// ═══════════════ SERVICE DESK: ЭСКАЛАЦИЯ (r_keeper) ═══════════════

enum TicketLevel {
  DEALER
  VENDOR
}   // 1-я линия дилер → эскалация к нам
enum TicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

model Ticket {
  id         String       @id @default(cuid())
  accountId  String
  dealerId   String?
  level      TicketLevel  @default(DEALER)
  status     TicketStatus @default(OPEN)
  priority   String       @default("normal") // low|normal|high|critical
  subject    String
  body       String
  // SLA: срок реакции по приоритету; просрочка → авто-эскалация
  dueAt      DateTime
  escalatedAt DateTime?
  escalationReason String?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([dealerId, status])
}

/// Цех приготовления: горячий, холодный, бар, мангал.
/// Нужен KDS: повар у мангала не должен видеть салаты,
/// а бармен — горячее. Иначе экран превращается в свалку.
model Station {
  id         String  @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  products   Product[]

  @@index([locationId])
}

/// Бронь стола. Неподтверждённые брони — главная причина пустых
/// столов в час пик: гость забронировал и не пришёл, а стол держали.
/// Поэтому подтверждение обязательно, напоминание за 2 часа.
model Reservation {
  id         String   @id @default(cuid())
  accountId  String
  locationId String
  tableId    String?
  table      DiningTable? @relation(fields: [tableId], references: [id])
  guestName  String
  phone      String
  guests     Int      @default(2)
  startAt    DateTime
  durationMin Int     @default(120)
  status     ReservationStatus @default(NEW)
  prepaid    Int      @default(0)   // предоплата в тиынах
  comment    String?
  createdAt  DateTime @default(now())
  confirmedAt DateTime?

  @@index([locationId, startAt])
}

enum ReservationStatus {
  NEW        // создана, гость не подтвердил
  CONFIRMED  // подтвердил по звонку или ссылке
  SEATED     // гость сел за стол
  NO_SHOW    // не пришёл — считаем отдельно, это потеря
  CANCELLED
}

/// Поставщик. Без справочника невозможна сверка: в накладных
/// остаётся текст «ИП Ербол», и через полгода никто не помнит,
/// тот же это Ербол или другой.
model Supplier {
  id         String  @id @default(cuid())
  accountId  String
  name       String
  binIin     String?           // БИН/ИИН для сверки и документов
  phone      String?
  contact    String?           // имя менеджера, с кем говорить
  category   String?           // «мясо», «овощи», «бар»
  deferDays  Int     @default(0)  // отсрочка платежа по договору
  isActive   Boolean @default(true)
  note       String?
  createdAt  DateTime @default(now())

  requests   SupplyRequest[]

  @@index([accountId])
}

/// Заявка поставщику. Заказ по телефону забывается — через день
/// никто не помнит, что заказывали и когда обещали привезти.
model SupplyRequest {
  id          String   @id @default(cuid())
  accountId   String
  locationId  String
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  number      Int
  status      SupplyRequestStatus @default(DRAFT)
  expectedAt  DateTime?
  note        String?
  createdBy   String
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  closedAt    DateTime?

  lines       SupplyRequestLine[]

  @@index([accountId, status])
}

model SupplyRequestLine {
  id         String  @id @default(cuid())
  requestId  String
  request    SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId  String
  qty        Decimal
  receivedQty Decimal @default(0)   // сколько реально привезли
  note       String?
}

enum SupplyRequestStatus {
  DRAFT      // собирается
  SENT       // отправлена поставщику
  PARTIAL    // привезли не всё
  RECEIVED   // закрыта приходом
  CANCELLED
}

/// Минимальный и максимальный остаток. Система сама говорит,
/// что заканчивается, — заведение не должно узнавать о нехватке
/// от гостя, которому не смогли подать блюдо.
model StockLimit {
  id          String  @id @default(cuid())
  warehouseId String
  productId   String
  minQty      Decimal          // ниже — пора заказывать
  maxQty      Decimal?         // выше — перезатарились, деньги стоят
  supplierId  String?          // у кого обычно берём

  @@unique([warehouseId, productId])
  @@index([warehouseId])
}

enum TaxMode {
  SIMPLIFIED  // упрощёнка: 3% с оборота, НДС не выделяется
  VAT         // общий режим: НДС в чеке
  RETAIL      // розничный налог
}

/// Купон: код на скидку или подарок. В отличие от бонусов
/// не требует регистрации гостя — работает по коду из рекламы,
/// с флаера или из рассылки.
model Coupon {
  id          String   @id @default(cuid())
  accountId   String
  code        String                    // BESH20, NEWYEAR
  title       String                    // «Скидка 20% на бешбармак»
  kind        CouponKind
  value       Int                       // проценты или тиыны
  productId   String?                   // если купон на конкретное блюдо
  minTotal    Int      @default(0)      // порог суммы чека
  /// Ограничение по количеству: акция не должна разорить заведение,
  /// если код утечёт в интернет
  maxUses     Int?
  usedCount   Int      @default(0)
  perGuest    Int      @default(1)      // сколько раз может один гость
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  uses        CouponUse[]

  @@unique([accountId, code])
  @@index([accountId, isActive])
}

model CouponUse {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String
  customerId String?
  amount     Int                        // сколько скинули по факту
  at         DateTime @default(now())

  @@index([couponId])
  @@index([orderId])
}

enum CouponKind {
  PERCENT      // процент от чека
  AMOUNT       // фиксированная сумма
  FREE_ITEM    // блюдо в подарок
}

/// Схема оплаты сотрудника. Три варианта покрывают весь общепит:
/// оклад у менеджера, ставка за смену у кассира, процент у официанта.
/// Комбинируются: ставка плюс процент — самая частая связка.
model PayrollRule {
  id          String   @id @default(cuid())
  accountId   String
  userId      String
  locationId  String?
  /// Оклад в месяц, тиыны
  salary      Int      @default(0)
  /// Ставка за смену — для тех, кто работает через день
  perShift    Int      @default(0)
  /// Почасовая — для подработки
  perHour     Int      @default(0)
  /// Процент с личных продаж
  salesPct    Decimal  @default(0)
  /// Процент с продаж своей категории: бармен с бара,
  /// повар с кухни — иначе официант получает за чужую работу
  categoryId  String?
  isActive    Boolean  @default(true)
  startsAt    DateTime @default(now())

  @@index([accountId, userId])
}

/// Начисления и выплаты. Метод начисления: сначала записываем,
/// что должны, потом отмечаем выплату. Без этого невозможно
/// понять, сколько заведение должно людям прямо сейчас.
model PayrollEntry {
  id         String   @id @default(cuid())
  accountId  String
  userId     String
  kind       PayrollKind
  amount     Int                    // тиыны, положительное — начислено
  periodFrom DateTime
  periodTo   DateTime
  note       String?
  shiftId    String?
  paidAt     DateTime?
  byUserId   String
  createdAt  DateTime @default(now())

  @@index([accountId, userId, periodFrom])
}

enum PayrollKind {
  SALARY      // оклад
  SHIFT       // за смену
  HOURLY      // почасовая
  SALES_PCT   // процент с продаж
  TIPS        // чаевые
  BONUS       // премия
  FINE        // штраф (отрицательная сумма)
  ADVANCE     // аванс (отрицательная — уменьшает остаток)
}

/// Инвентаризация без остановки продаж.
/// Запоминаем момент начала: всё, что продали и приняли во время
/// пересчёта, учитывается автоматически. Иначе кладовщик считает
/// два часа, за которые продали половину, и цифры не сходятся.
model Inventory {
  id           String    @id @default(cuid())
  accountId    String
  warehouseId  String
  number       Int
  status       InventoryStatus @default(COUNTING)
  /// Точка отсчёта: остатки на этот момент считаются книжными
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdBy    String
  note         String?

  lines        InventoryLine[]

  @@index([accountId, warehouseId])
}

model InventoryLine {
  id           String    @id @default(cuid())
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId    String
  /// Книжный остаток на момент старта — фиксируем, чтобы потом
  /// не пересчитывать и не спорить
  bookQty      Decimal
  /// Фактический пересчёт. Null означает «ещё не считали» —
  /// это не то же самое, что ноль на складе
  factQty      Decimal?
  /// Движения после старта: продажи и приходы во время пересчёта
  movedQty     Decimal   @default(0)
  avgCost      Int       @default(0)
  countedBy    String?
  countedAt    DateTime?

  @@unique([inventoryId, productId])
}

enum InventoryStatus {
  COUNTING   // идёт пересчёт
  POSTED     // проведена, остатки скорректированы
  CANCELLED
}

/// Расписание меню: бизнес-ланч с 12 до 16, бар после 18,
/// завтраки до 11. Без этого кассир вручную следит за временем
/// и продаёт ланч в девять вечера.
model MenuSchedule {
  id         String   @id @default(cuid())
  accountId  String
  locationId String?
  name       String                  // «Бизнес-ланч», «Завтраки»
  /// Дни недели: 0 = понедельник. Пустой массив — все дни
  days       Int[]    @default([])
  fromMin    Int                     // минуты от полуночи: 12:00 = 720
  toMin      Int
  /// Цены в это время: отдельный прайс или процент от базового
  pricePct   Int?                    // 80 = скидка 20% на всё меню
  isActive   Boolean  @default(true)

  items      MenuScheduleItem[]

  @@index([accountId, locationId])
}

model MenuScheduleItem {
  id         String       @id @default(cuid())
  scheduleId String
  schedule   MenuSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  productId  String
  /// Своя цена в это время. Null — берём базовую с процентом
  price      Int?
  /// Показывать только в это время или всегда, но дешевле
  onlyInTime Boolean      @default(false)

  @@unique([scheduleId, productId])
}

/// Партия с датой изготовления. Нужна для контроля сроков:
/// в холодильнике три кастрюли зирвака, и повар должен взять
/// ту, что старше, а не ту, что ближе.
model StockBatch {
  id           String   @id @default(cuid())
  accountId    String
  warehouseId  String
  productId    String
  qty          Decimal
  unitCost     Int      @default(0)
  producedAt   DateTime @default(now())
  expiresAt    DateTime?
  /// Кто приготовил — при жалобе видно, чья смена
  byUserId     String?
  docId        String?
  isWrittenOff Boolean  @default(false)

  @@index([warehouseId, productId, expiresAt])
}
