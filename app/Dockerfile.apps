# Сборка веб-приложений в статику: бэк-офис, KDS, курьер, меню гостя.
# Все четыре раздаются тем же Caddy, что и сайт — отдельные серверы не нужны.
FROM node:20-alpine AS build
WORKDIR /build
RUN npm i -g pnpm@9
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/backoffice ./apps/backoffice
COPY apps/kds ./apps/kds
COPY apps/courier ./apps/courier
COPY apps/guest ./apps/guest
RUN pnpm install --no-frozen-lockfile
RUN cd apps/backoffice && pnpm exec vite build --base=/office/
RUN cd apps/kds && pnpm exec vite build --base=/kds/
RUN cd apps/courier && pnpm exec vite build --base=/courier/
RUN cd apps/guest && pnpm exec vite build --base=/menu/

FROM alpine
RUN apk add --no-cache rsync
COPY --from=build /build/apps/backoffice/dist /dist/office
COPY --from=build /build/apps/kds/dist /dist/kds
COPY --from=build /build/apps/courier/dist /dist/courier
COPY --from=build /build/apps/guest/dist /dist/menu
# Без --delete: том смонтирован в папку сайта, и удаление снесло бы
# все страницы. Копируем только свои подпапки, каждую с очисткой внутри
CMD ["sh", "-c", "for d in office kds courier menu; do rsync -a --delete /dist/$d/ /out/$d/; done && echo 'Собрано: office, kds, courier, menu'"]
