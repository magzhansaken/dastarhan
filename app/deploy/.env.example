# ═══ Dastarhan POS — переменные production ═══
# Скопируйте в .env рядом с docker-compose.prod.yml и заполните.

# Домен (Caddy возьмёт TLS сам)
APP_DOMAIN=app.dastarhan.kz

# База
DB_USER=dastarhan
DB_PASSWORD=ЗАМЕНИТЕ_ДЛИННЫМ_ПАРОЛЕМ
DB_NAME=dastarhan
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=ЗАМЕНИТЕ_СЛУЧАЙНОЙ_СТРОКОЙ_64+

# ═══ Фискализация (Этап 3/S4) ═══
# Webkassa: боевой https://kassa.webkassa.kz | тест https://devkassa.webkassa.kz
WEBKASSA_BASE_URL=https://devkassa.webkassa.kz
WEBKASSA_LOGIN=
WEBKASSA_PASSWORD=
WEBKASSA_CASHBOX_NUMBER=
# re:Kassa (альтернатива; можно оба — выбор на аккаунте)
REKASSA_BASE_URL=https://api.rekassa.kz
REKASSA_CASHBOX_NUMBER=
REKASSA_TOKEN=

# ═══ Kaspi (S4) ═══
KASPI_AUTHKEY=            # выдаёт контактное лицо Kaspi (см. доки)
KASPI_QR_TTL_MS=300000

# ═══ Telegram-бот (S4) ═══
TELEGRAM_BOT_TOKEN=       # из @BotFather
TELEGRAM_WEBHOOK_SECRET=ЗАМЕНИТЕ_СЛУЧАЙНОЙ_СТРОКОЙ

# ═══ Wolt (S4) ═══
WOLT_VENUE_ID=
WOLT_API_KEY=
# Вебхук для Wolt: https://${APP_DOMAIN}/api/integrations/wolt/webhook

# ═══ ИИ-модуль (Этап 8) ═══
ANTHROPIC_API_KEY=        # Claude API: накладные с фото, отчёты по запросу

# ═══ Хранилище файлов (фото накладных, изображения блюд) ═══
S3_ENDPOINT=
S3_BUCKET=dastarhan
S3_ACCESS_KEY=
S3_SECRET_KEY=
