{
  "name": "dastarhan",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,office,pos -c blue,green,yellow \"pnpm dev:api\" \"pnpm dev:office\" \"pnpm dev:pos\"",
    "dev:api": "pnpm --filter @dastarhan/api dev",
    "dev:office": "pnpm --filter @dastarhan/backoffice dev",
    "dev:pos": "pnpm --filter @dastarhan/pos dev",
    "build": "pnpm -r build",
    "db:generate": "prisma generate --schema packages/db/schema.prisma",
    "db:push": "prisma db push --schema packages/db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/schema.prisma",
    "db:seed": "tsx packages/db/seed.ts",
    "db:studio": "prisma studio --schema packages/db/schema.prisma",
    "setup": "pnpm install && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "test": "node scripts/run-tests.mjs",
    "db:seed:demo": "tsx packages/db/seed-demo.ts",
    "db:seed:full": "tsx packages/db/seed.ts && tsx packages/db/seed-demo.ts && tsx packages/db/seed-full.ts && tsx packages/db/seed-plans.ts",
    "db:seed:plans": "tsx packages/db/seed-plans.ts",
    "typecheck": "pnpm -r --filter './apps/*' exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "tsx": "^4.19.2"
  }
}
