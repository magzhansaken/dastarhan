{
	auto_https disable_redirects
}

# Внутренний вход — сюда проксирует Caddy тендера
:80 {
	encode zstd gzip

	# API проекта
	handle /api/* {
		reverse_proxy dastarhan-api:3000
	}

	# Веб-приложения: каждое — SPA, поэтому неизвестный путь
	# отдаём на index.html, чтобы работала внутренняя навигация
	handle /office/* {
		root * /srv
		try_files {path} /office/index.html
		file_server
	}
	handle /kds/* {
		root * /srv
		try_files {path} /kds/index.html
		file_server
	}
	handle /courier/* {
		root * /srv
		try_files {path} /courier/index.html
		file_server
	}
	handle /menu/* {
		root * /srv
		try_files {path} /menu/index.html
		file_server
	}
	handle /admin/* {
		root * /srv
		try_files {path} /admin/index.html
		file_server
	}

	# Сайт
	handle {
		root * /srv
		header /*.html Cache-Control "no-cache"
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			-Server
		}
		file_server
		try_files {path} {path}/ {path}.html
	}

	handle_errors {
		rewrite /404.html
		root * /srv
		file_server
	}
}

# Резервный прямой вход
dastarhan.duckdns.org:8443 {
	tls internal
	encode zstd gzip
	handle /api/* {
		reverse_proxy dastarhan-api:3000
	}
	handle {
		root * /srv
		file_server
		try_files {path} {path}/ {path}.html
	}
}
